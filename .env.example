DATABASE_URL=postgresql://filetools:filetools@localhost:5432/filetools
REDIS_URL=redis://localhost:6379
STORAGE_PATH=./data
MAX_FILE_SIZE=104857600
JOB_TTL=3600
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# --- Update checking (optional, defaults apply) ---
# GitHub repo:owner that supplies updates. Defaults: TheDevfromDevshome / filetools
# GITHUB_OWNER=TheDevfromDevshome
# GITHUB_REPO=filetools
# GITHUB_BRANCH=main
# How often to check for updates, in ms (default: 21600000 = 6h)
# UPDATE_CHECK_INTERVAL=21600000
